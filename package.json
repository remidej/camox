{
  "name": "camox-monorepo",
  "version": "0.40.0",
  "private": true,
  "license": "MIT",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "nx run-many -t build --all",
    "dev": "nx run-many -t dev -p @camox/api dashboard playground camox --parallel=4",
    "dev:all": "nx run-many -t dev --all --parallel=7",
    "dev:servers": "nx run-many -t dev -p @camox/api dashboard --parallel=2",
    "db:studio": "nx run @camox/api:db:studio",
    "lint": "nx run-many -t lint --all",
    "test": "nx run-many -t test --all",
    "format": "vp fmt .",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "seed": "nx run @camox/api:seed",
    "deploy": "nx run-many -t deploy --all",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@typescript/native-preview": "7.0.0-dev.20260412.1",
    "nx": "^21.6.11",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@11.1.3"
}
