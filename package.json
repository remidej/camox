{
  "name": "camox-monorepo",
  "version": "0.47.0",
  "private": true,
  "license": "MIT",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "nx run-many -t build --all",
    "dev": "node scripts/dev.mjs -p @camox/api dashboard playground camox --parallel=4",
    "dev:all": "node scripts/dev.mjs --all --parallel=7",
    "dev:servers": "node scripts/dev.mjs -p @camox/api dashboard --parallel=2",
    "test:dev": "node --test scripts/*.test.mjs",
    "db:studio": "nx run @camox/api:db:studio",
    "test": "nx run-many -t test --all",
    "format": "vp fmt .",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "seed": "nx run @camox/api:seed",
    "deploy": "nx run-many -t deploy --all",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "nx": "^23.3.0",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@11.1.3"
}
