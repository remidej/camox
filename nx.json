{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.md"
    ]
  },
  "targetDefaults": {
    "build": {
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tsconfig.dts.*.json",
        {
          "env": "VITE_API_URL"
        },
        {
          "env": "VITE_DASHBOARD_URL"
        }
      ],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["^build"],
      "cache": true
    },
    "build:watch": {
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "cache": false
    },
    "dev": {
      "cache": false
    },
    "test": {
      "inputs": ["default", "^production"],
      "cache": true
    }
  },
  "maxCacheSize": "500MB",
  "tui": {
    "enabled": false
  },
  "defaultBase": "main",
  "nxCloudId": "6ad1deecb8130ab58ee864b3"
}
