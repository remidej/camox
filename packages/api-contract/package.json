{
  "name": "@camox/api-contract",
  "version": "0.44.0",
  "license": "MIT",
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./query-keys": {
      "types": "./src/query-keys.ts",
      "default": "./src/query-keys.ts"
    },
    "./ids": {
      "types": "./src/ids.ts",
      "default": "./src/ids.ts"
    },
    "./drafts": {
      "types": "./src/drafts.ts",
      "default": "./src/drafts.ts"
    },
    "./icon-catalog": {
      "types": "./src/icon-catalog.ts",
      "default": "./src/icon-catalog.ts"
    },
    "./analytics": {
      "types": "./src/analytics.ts",
      "default": "./src/analytics.ts"
    },
    "./threads": {
      "types": "./src/threads.ts",
      "default": "./src/threads.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./query-keys": {
        "types": "./dist/query-keys.d.ts",
        "default": "./dist/query-keys.js"
      },
      "./ids": {
        "types": "./dist/ids.d.ts",
        "default": "./dist/ids.js"
      },
      "./drafts": {
        "types": "./dist/drafts.d.ts",
        "default": "./dist/drafts.js"
      },
      "./icon-catalog": {
        "types": "./dist/icon-catalog.d.ts",
        "default": "./dist/icon-catalog.js"
      },
      "./analytics": {
        "types": "./dist/analytics.d.ts",
        "default": "./dist/analytics.js"
      },
      "./threads": {
        "types": "./dist/threads.d.ts",
        "default": "./dist/threads.js"
      }
    }
  },
  "scripts": {
    "build": "vp pack"
  },
  "dependencies": {
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-durable": {
      "optional": true
    }
  },
  "nx": {
    "tags": [
      "type:pkg"
    ],
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/apps/api/src/**/*",
          "{workspaceRoot}/packages/ai-tools/src/**/*",
          "!{workspaceRoot}/**/*.test.ts"
        ]
      }
    }
  }
}
