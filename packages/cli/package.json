{
  "name": "@camox/cli",
  "version": "0.56.0",
  "license": "MIT",
  "bin": {
    "camox": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs",
    "./auth": {
      "source": "./src/lib/auth-core.ts",
      "types": "./dist/lib/auth-core.d.mts",
      "import": "./dist/lib/auth-core.mjs"
    }
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./auth": {
        "types": "./dist/lib/auth-core.d.mts",
        "import": "./dist/lib/auth-core.mjs"
      }
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "setup:template-artifacts": "bash scripts/setup-template-artifacts.sh",
    "test": "node --test test/*.test.mjs",
    "test:network": "node --test test/network/*.test.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@optique/core": "^1.3.6",
    "@optique/run": "^1.3.6",
    "@orpc/client": "^1.15.7",
    "@orpc/server": "^1.15.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@camox/api-contract": "workspace:*",
    "@types/node": "^24.12.4",
    "vite-plus": "catalog:"
  },
  "nx": {
    "tags": [
      "type:pkg"
    ],
    "targets": {
      "test": {
        "dependsOn": [
          "build"
        ]
      }
    }
  }
}
