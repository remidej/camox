{
  "name": "@camox/cli",
  "version": "0.41.1",
  "license": "MIT",
  "bin": {
    "camox": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "templates"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs",
    "./auth": {
      "source": "./src/lib/auth-core.ts",
      "types": "./dist/lib/auth-core.d.mts",
      "import": "./dist/lib/auth-core.mjs"
    }
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./auth": {
        "types": "./dist/lib/auth-core.d.mts",
        "import": "./dist/lib/auth-core.mjs"
      }
    }
  },
  "scripts": {
    "build": "node scripts/sync-templates.mjs && vp pack",
    "dev": "node scripts/sync-templates.mjs --watch --build",
    "lint": "vp lint",
    "check": "tsgo --noEmit && vp lint --fix"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "@optique/core": "^1.0.2",
    "@optique/run": "^1.0.2",
    "@orpc/client": "^1.14.3",
    "@orpc/server": "^1.14.3",
    "slugify": "^1.6.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@camox/api-contract": "workspace:*",
    "@types/node": "^24.12.4",
    "@typescript/native-preview": "7.0.0-dev.20260412.1",
    "vite-plus": "catalog:"
  },
  "nx": {
    "tags": [
      "type:pkg"
    ]
  }
}
