{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "camox-landing",
  "compatibility_date": "2026-04-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "camox/worker",
  "routes": [{ "pattern": "camox.dev", "custom_domain": true }],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
    },
  },
}
