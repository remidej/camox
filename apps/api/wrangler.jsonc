{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "camox-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-28",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "api.camox.dev", "custom_domain": true }],
  "vars": {
    "DASHBOARD_URL": "https://app.camox.dev",
    // The alerts address. An Email Routing rule forwards it to an inbox (src/domains/releases/README.md).
    "ALERT_EMAIL_TO": "alerts@camox.dev",
  },
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true,
      "allowed_sender_addresses": ["auth@camox.dev", "alerts@camox.dev"],
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "camox",
      "database_id": "3cba2c05-3758-40b9-bb10-fc7c8568c391",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES_BUCKET",
      "bucket_name": "camox-files",
    },
    // The release sandboxes' workspace snapshots, which cache each project's install on its
    // lockfile. The release sandbox Worker writes them; the Workflow looks up the cache.
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "camox-release-cache",
    },
  ],
  "media": {
    "binding": "MEDIA",
    "remote": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AI_JOB_SCHEDULER",
        "class_name": "AiJobScheduler",
      },
      {
        "name": "ProjectRoom",
        "class_name": "ProjectRoom",
      },
      {
        "name": "THREAD",
        "class_name": "Thread",
      },
      // Runs the threads' code mode scripts in its own Worker (sandbox/wrangler.jsonc), so a
      // script that computes doesn't hold up a thread (ADR 0018).
      {
        "name": "CODEMODE_SANDBOX",
        "class_name": "CodemodeSandbox",
        "script_name": "camox-codemode-sandbox",
      },
      // The Container sandboxes each release step runs in, in their own Worker
      // (release-sandbox/wrangler.jsonc), which deploys their image.
      {
        "name": "SANDBOX",
        "class_name": "CiSandbox",
        "script_name": "camox-release-sandbox",
      },
    ],
  },
  // A push to a project's repo releases it (src/domains/releases/README.md). The event filter can
  // only name the namespace, so the Workflow skips other branches and repos that aren't a
  // project's, such as `template-default`.
  "triggers": {
    "events": [
      {
        "type": "cf.artifacts.repo.pushed",
        "filter": { "namespace": "projects" },
        "targets": [{ "type": "workflow", "workflow_name": "camox-release" }],
      },
    ],
  },
  "workflows": [
    {
      "name": "camox-release",
      "binding": "RELEASE_WORKFLOW",
      "class_name": "ReleaseWorkflow",
    },
  ],
  // Remote even in local dev, as Cloudflare Artifacts has no local simulator.
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "projects", "remote": true }],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AiJobScheduler"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ProjectRoom"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["Thread"],
    },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
    },
  },
}
