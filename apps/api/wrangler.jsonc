{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "camox-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-28",
  "compatibility_flags": ["nodejs_compat"],
  // Markdown imports are their text: the platform's skills (src/domains/code/platform-skills.ts).
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "routes": [{ "pattern": "api.camox.ai", "custom_domain": true }],
  "vars": {
    "DASHBOARD_URL": "https://app.camox.ai",
    // The alerts address. Email Routing forwards it to an inbox (src/domains/releases/README.md).
    "ALERT_EMAIL_TO": "alerts@camox.ai",
  },
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true,
      "allowed_sender_addresses": ["auth@camox.ai", "alerts@camox.ai"],
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "camox",
      "database_id": "3cba2c05-3758-40b9-bb10-fc7c8568c391",
      "migrations_dir": "migrations",
    },
  ],
  // Project Slug or Custom Domain → Project ID, the map the dispatch Worker serves websites from
  // (apps/dispatch). The studio's sign-in reads it to tell a project's host.
  "kv_namespaces": [{ "binding": "PROJECT_SLUGS", "id": "0f6abd3321cf43938cf0f9a59b2c555f" }],
  // Dispatch loads drafts' revisions (apps/dispatch/src/revisions.ts): the API reads their
  // Definition Sets through it. Dispatch deploys first, as it serves the entrypoint.
  "services": [
    { "binding": "DISPATCH", "service": "camox-dispatch", "entrypoint": "CamoxRevisions" },
  ],
  // Browser Run's Chromium, which the agent's `look` captures a draft's pages in, from its
  // thread (src/domains/looks/browser-run.ts).
  "browser": { "binding": "BROWSER" },
  "r2_buckets": [
    {
      "binding": "FILES_BUCKET",
      "bucket_name": "camox-files",
    },
    // The release sandboxes' workspace snapshots, which cache each project's install on its
    // lockfile. The release sandbox Worker writes them; the Workflow looks up the cache.
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "camox-release-cache",
    },
    // Each revision's build, as one archive, which serves the draft's preview and a publish
    // (src/domains/revisions).
    {
      "binding": "REVISION_BUILDS",
      "bucket_name": "camox-revision-builds",
    },
    // The skills each `camox` version ships, which the SDK's publish uploads and the agent reads
    // (src/domains/code/skills.ts).
    {
      "binding": "SKILLS",
      "bucket_name": "camox-skills",
    },
  ],
  // Workers AI, for the agent's web tools: Cloudflare's Web Search API, and converting the pages
  // it fetches to Markdown (src/domains/threads/web-tools.ts).
  "ai": { "binding": "AI", "remote": true },
  "media": {
    "binding": "MEDIA",
    "remote": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AI_JOB_SCHEDULER",
        "class_name": "AiJobScheduler",
      },
      {
        "name": "ProjectRoom",
        "class_name": "ProjectRoom",
      },
      // Batches purges of the edge cache, which the account's purge rate limit caps
      // (src/durable-objects/edge-cache-purger.ts).
      {
        "name": "EDGE_CACHE_PURGER",
        "class_name": "EdgeCachePurger",
      },
      {
        "name": "THREAD",
        "class_name": "Thread",
      },
      // A read-only copy of each project's `main`, which the agent reads its code from
      // (src/durable-objects/project-code.ts).
      {
        "name": "PROJECT_CODE",
        "class_name": "ProjectCode",
      },
      // Each draft with code's working copy, which the agent changes code in
      // (src/durable-objects/draft-code.ts).
      {
        "name": "DRAFT_CODE",
        "class_name": "DraftCode",
      },
      // Runs the threads' code mode scripts in its own Worker (sandbox/wrangler.jsonc), so a
      // script that computes doesn't hold up a thread (ADR 0018).
      {
        "name": "CODEMODE_SANDBOX",
        "class_name": "CodemodeSandbox",
        "script_name": "camox-codemode-sandbox",
      },
      // The Container sandboxes each release step runs in, in their own Worker
      // (release-sandbox/wrangler.jsonc), which deploys their image.
      {
        "name": "SANDBOX",
        "class_name": "CiSandbox",
        "script_name": "camox-release-sandbox",
      },
      // The Container sandbox each draft with code builds its revisions in, named by the draft's
      // ID, in the release sandbox Worker, which deploys their image (src/domains/revisions).
      {
        "name": "REVISION_SANDBOX",
        "class_name": "RevisionSandbox",
        "script_name": "camox-release-sandbox",
      },
    ],
  },
  // A push to a project's repo releases it (src/domains/releases/README.md). The event filter can
  // only name the namespace, so the Workflow skips other branches and repos that aren't a
  // project's, such as `template-default`.
  "triggers": {
    // Daily: a new snapshot of Google Fonts' families for the agent's `searchFonts`
    // (src/domains/fonts/catalog.ts), taken with the `GOOGLE_FONTS_API_KEY` secret.
    "crons": ["17 4 * * *", "0 */6 * * *"],
    "events": [
      {
        "type": "cf.artifacts.repo.pushed",
        "filter": { "namespace": "projects" },
        "targets": [{ "type": "workflow", "workflow_name": "camox-release" }],
      },
    ],
  },
  "workflows": [
    {
      "name": "camox-release",
      "binding": "RELEASE_WORKFLOW",
      "class_name": "ReleaseWorkflow",
    },
    // Copies the Template into a new project's repo (src/domains/project-creation/README.md).
    {
      "name": "camox-project-creation",
      "binding": "PROJECT_CREATION_WORKFLOW",
      "class_name": "ProjectCreationWorkflow",
    },
    // Deletes a deleted project's Worker and repo (src/domains/project-deletion/README.md).
    {
      "name": "camox-project-deletion",
      "binding": "PROJECT_DELETION_WORKFLOW",
      "class_name": "ProjectDeletionWorkflow",
    },
    // Moves every project to a newly published SDK; deploy.yml starts it after each publish
    // (src/domains/upgrades/README.md).
    {
      "name": "camox-upgrade",
      "binding": "UPGRADE_WORKFLOW",
      "class_name": "UpgradeWorkflow",
    },
    // Publishes a draft with code (src/domains/publishes/README.md).
    {
      "name": "camox-publish",
      "binding": "PUBLISH_WORKFLOW",
      "class_name": "PublishWorkflow",
    },
    {
      "name": "camox-project-upgrade",
      "binding": "PROJECT_UPGRADE_WORKFLOW",
      "class_name": "ProjectUpgradeWorkflow",
    },
  ],
  // Remote even in local dev, as Cloudflare Artifacts has no local simulator.
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "projects", "remote": true }],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AiJobScheduler"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ProjectRoom"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["Thread"],
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["EdgeCachePurger"],
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["ProjectCode"],
    },
    {
      "tag": "v6",
      "new_sqlite_classes": ["DraftCode"],
    },
  ],
  // Cloudflare caches the public reads the `EdgeCache` entrypoint answers, in front of the Worker
  // (src/edge-cache.ts). The default entrypoint, which answers everything else, caches nothing.
  "exports": {
    "EdgeCache": { "type": "worker", "cache": { "enabled": true } },
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
    },
  },
}
