{
  "name": "@camox/api",
  "version": "0.7.0",
  "private": true,
  "license": "FSL-1.1-MIT",
  "files": [
    "src"
  ],
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "deploy": "pnpm run db:migrate:remote && wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/dev-seed.ts",
    "test": "vp test --run"
  },
  "dependencies": {
    "@camox/ai-tools": "workspace:*",
    "@camox/api-contract": "workspace:*",
    "@cfworker/json-schema": "^4.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@orpc/server": "^1.15.7",
    "@tanstack/ai": "^0.69.0",
    "@tanstack/ai-openrouter": "^0.22.0",
    "better-auth": "~1.6.33",
    "drizzle-orm": "^0.45.4",
    "effect": "^4.0.5",
    "fractional-indexing": "^4.0.0",
    "hono": "^4.13.13",
    "hono-party": "^2.1.0",
    "outdent": "^0.8.0",
    "partyserver": "^0.5.10",
    "slugify": "^1.6.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@libsql/client": "^0.18.0",
    "@types/node": "^22.19.19",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.151.0"
  },
  "nx": {
    "tags": [
      "type:app"
    ],
    "namedInputs": {
      "testSources": [
        "{workspaceRoot}/apps/playground/src/collections/**/*",
        "{workspaceRoot}/packages/sdk/src/core/**/*",
        "!{workspaceRoot}/packages/sdk/src/**/*.test.*",
        "!{workspaceRoot}/packages/sdk/src/**/*.type-test.*",
        "!{workspaceRoot}/packages/sdk/src/**/*.fixtures.*"
      ]
    },
    "targets": {
      "test": {
        "executor": "nx:noop",
        "dependsOn": [
          "test-shard-1",
          "test-shard-2",
          "test-shard-3"
        ]
      },
      "test-shard-1": {
        "command": "vp test --run --shard=1/3",
        "options": {
          "cwd": "{projectRoot}"
        },
        "inputs": [
          "default",
          "^production",
          "testSources"
        ],
        "cache": true
      },
      "test-shard-2": {
        "command": "vp test --run --shard=2/3",
        "options": {
          "cwd": "{projectRoot}"
        },
        "inputs": [
          "default",
          "^production",
          "testSources"
        ],
        "cache": true
      },
      "test-shard-3": {
        "command": "vp test --run --shard=3/3",
        "options": {
          "cwd": "{projectRoot}"
        },
        "inputs": [
          "default",
          "^production",
          "testSources"
        ],
        "cache": true
      }
    }
  }
}
