{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Serves each project's website at <slug>.camox.site by forwarding to the project's user Worker in
  // the `production` dispatch namespace. README.md records the Cloudflare setup it relies on.
  "name": "camox-dispatch",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-28",
  "workers_dev": false,
  "preview_urls": false,
  // Each Custom Domain has its own route, on its own zone (README.md).
  "routes": [
    { "pattern": "*.camox.site/*", "zone_name": "camox.site" },
    { "pattern": "camox.ai/*", "zone_name": "camox.ai" },
  ],
  "dispatch_namespaces": [{ "binding": "DISPATCHER", "namespace": "production" }],
  // slug or Custom Domain → project UUID; the UUID names the project's user Worker. A slug's entry
  // names its project's Custom Domain in its metadata, which it then redirects to (README.md).
  "kv_namespaces": [{ "binding": "PROJECT_SLUGS", "id": "0f6abd3321cf43938cf0f9a59b2c555f" }],
  // Loads drafts' revisions as Dynamic Workers, from their builds in `REVISION_BUILDS`, which the
  // API's revision sandboxes write (src/revisions.ts).
  "worker_loaders": [{ "binding": "LOADER" }],
  "r2_buckets": [{ "binding": "REVISION_BUILDS", "bucket_name": "camox-revision-builds" }],
  // Says which members see a draft's revision, and which revision it previews (src/previews.ts).
  "services": [{ "binding": "API", "service": "camox-api", "entrypoint": "CamoxPreviews" }],
  "vars": {
    // The only origin a revision's gateway sends in the revision's draft.
    "CAMOX_API_URL": "https://api.camox.ai",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
}
